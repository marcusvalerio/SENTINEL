# PostgreSQL connection string (Neon in production).
# Use the *pooled* Neon connection string, e.g.
# postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/sentinel?sslmode=require
DATABASE_URL=

# Initial administrator. The account is created on first login (or via `npm run db:seed`)
# when no user with this e-mail exists. Never commit real values.
SENTINEL_ADMIN_EMAIL=marcus@sentinel.com
SENTINEL_ADMIN_PASSWORD=

# Optional: GitHub token (fine-grained, read-only metadata) used to verify repositories
# when connecting them to a project. Public repositories work without it.
GITHUB_TOKEN=
